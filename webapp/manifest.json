{
  "_version": "1.89.0",
  "sap.app": {
    "id": "zsp.itsm.zspfrequest",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.32.0",
      "toolsId": "341c1d92-3cfa-45cc-b8a5-f526ca70358d"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsp_itsm_p_request_ui_v4/srvd/sap/zsp_itsm_p_request_ui/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZSPF_REQUEST-display": {
          "semanticObject": "ZSPF_REQUEST",
          "action": "display",
          "title": "{{ZSPF_REQUEST-display.flpTitle}}",
          "subTitle": "{{ZSPF_REQUEST-display.flpSubtitle}}",
          "signature": {
            "parameters": {
              "Custno": {
                "required": false
              }
            },
            "additionalParameters": "ignored"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "zsp.itsm.zspfrequest.ext.controller.ListReportExt"
          }
        }
      }
    },
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zsp.itsm.zspfrequest.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/editor.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MainList",
          "target": "MainList"
        },
        {
          "pattern": "Main({key}):?query:",
          "name": "MainObjectPage",
          "target": "MainObjectPage"
        }
      ],
      "targets": {
        "MainList": {
          "type": "Component",
          "id": "MainList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "initialLoad": true,
              "contextPath": "/Main",
              "variantManagement": "Page",
              "navigation": {
                "Main": {
                  "detail": {
                    "route": "MainObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  }
                }
              }
            }
          }
        },
        "MainObjectPage": {
          "type": "Component",
          "id": "MainObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Main",
              "controllerExtensions": {
                "sap.fe.templates.ObjectPage.ObjectPageController": {
                  "controllerName": "zsp.itsm.zspfrequest.ext.controller.ObjectPageExt"
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "ReqComent": {
                      "template": "zsp.itsm.zspfrequest.ext.fragment.ReqComent",
                      "position": {
                        "placement": "After",
                        "anchor": "ItemAttachment"
                      },
                      "title": "요청내역"
                    },
                    "ProComent": {
                      "template": "zsp.itsm.zspfrequest.ext.fragment.ProComent",
                      "position": {
                        "placement": "After",
                        "anchor": "ReqComent"
                      },
                      "title": "처리내역"
                    },
                    "ReqFeed": {
                      "template": "zsp.itsm.zspfrequest.ext.fragment.FeedNote",
                      "position": {
                        "placement": "After",
                        "anchor": "ProComent"
                      },
                      "title": "댓글"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
