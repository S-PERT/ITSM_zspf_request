<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <MultiInput
        id="CustomFilterProMngNameInput"
        showValueHelp="false"
        core:require="{ handler: 'zsp/itsm/zspfrequest/ext/controller/ListReportExt' }"
        tokenUpdate="handler.onTokenUpdate"
        change="handler.onInputChange"
        submit="handler.onFilterSubmit">
        <customData>
            <core:CustomData
                key="filterValue"
                value="{
                    path: 'filterValues>',
                    type: 'sap.fe.macros.filter.type.Value',
                    formatOptions: {
                        operator: 'zsp.itsm.zspfrequest.ext.controller.ListReportExt.filterProMngName'
                    }
                }" />
        </customData>
    </MultiInput>
</core:FragmentDefinition>
